{
  "name": "@ghiyar/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx test/integration.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "latest",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/throttler": "latest",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-parse": "7.0.3",
    "dotenv": "^17.2.0",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "prisma": "7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
