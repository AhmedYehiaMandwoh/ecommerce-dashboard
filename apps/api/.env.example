DATABASE_URL=mysql://ghiyar:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:3306/ghiyar
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Ordering is disabled unless explicitly set true. It is test-only in this release.
TEST_CHECKOUT=false
NODE_ENV=development

# Optional operational commands. Leave empty until set privately by operator.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
TEST_API_URL=http://127.0.0.1:4000/api
# Twilio Verify phone authentication adapter. Real values stay private.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_SEND_ENABLED=false

# Explicit local testing only. Fixed code: 123456. Never use real customer numbers.
# Set disabled or twilio before release. Server refuses static-test in production.
OTP_MODE=static-test

# Exact web origin and domain, localhost permitted for local development.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Local uploaded images. Back up this persistent directory separately.
MEDIA_DIR=media
