    "dev:web": "pnpm --filter @ghiyar/web dev"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15 <25"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "effect": "3.22.1",
    "minimatch": "11.0.9"
  },
  "packageManager": "pnpm@12.23.0"
}