{
  "name": "ghiyar-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15 <25"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "effect": "3.22.1",
    "minimatch": "11.0.9"
  },
  "overrides": {
    "effect": "$effect",
    "minimatch": "$minimatch"
  }
}
