{
  "name": "ghiyar-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:api": "pnpm --filter @ghiyar/api build",
    "build:web": "pnpm --filter @ghiyar/web build",
    "test": "pnpm --filter @ghiyar/api test",
